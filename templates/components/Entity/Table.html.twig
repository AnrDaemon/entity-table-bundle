{% macro pager(total, current) %}
    {% if total > 0 %}
        {# Вычисляем список элементов пагинации #}
        {% if total <= 9 %}
            {# Если страниц 9 или меньше - выводим все #}
            {% set pages = range(1, total) %}
        {% else %}
            {# Страниц больше 9 –  выводим диапазоны страниц с троеточиями между ними #}
            {% if current <= 5 %}
                {# Если текущая страница ближе к началу #}
                {# Выводим страницы с 1 по current+1, затем троеточие, затем две последние страницы  #}
                {# Например: 1,2,3,4,5,6, ..., 9,10 (при total=10, current=4) #}
                {% set pages = range(1, current + 1)|merge(['...'])|merge(range(total - 1, total)) %}
            {% elseif current >= total - 4 %}
                {# Если текущая страница ближе к концу #}
                {# Выводим первые две страницы, троеточие, затем страницы с current-1 до total #}
                {# Например: 1,2, ..., 7,8,9,10 (при total=10, current=8) #}
                {% set pages = range(1, 2)|merge(['...'])|merge(range(current - 1, total)) %}
            {% else %}
                {# Если текущая страница в середине диапазона #}
                {# Выводим первые две страницы, троеточие, блок из текущей с соседями, троеточие, две последние #}
                {# Например: 1,2, ..., 5,6,7, ..., 24,25 (при total=25, current=6) #}
                {% set pages = range(1, 2)|merge(['...'])|merge(range(current - 1, current + 1))|merge(['...'])|merge(range(total - 1, total)) %}
            {% endif %}
        {% endif %}

        <nav>
            <ul class="pagination pagination-sm mb-0" style="--bs-pagination-font-size: 0.75rem !important;">
                {% if current > 1 %}
                    <li class="page-item">
                        <button type="button" class="page-link" data-model="page" data-value="1" data-action="live#update">&lt;&lt;</button>
                    </li>
                    <li class="page-item">
                        <button type="button" class="page-link" data-model="page" data-value="{{ current - 1 }}" data-action="live#update">&lt;</button>
                    </li>
                {% else %}
                    <li class="page-item disabled">
                        <span class="page-link">&lt;&lt;</span>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">&lt;</span>
                    </li>
                {% endif %}

                {% for page in pages %}
                    {% if page == '...' %}
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    {% else %}
                        <li class="page-item{% if current == page %} active{% endif %}">
                            <button type="button" class="page-link" data-model="page" data-value="{{ page }}" data-action="live#update">{{ page }}</button>
                        </li>
                    {% endif %}
                {% endfor %}

                {% if current < total %}
                    <li class="page-item">
                        <button type="button" class="page-link" data-model="page" data-value="{{ current + 1 }}" data-action="live#update">&gt;</button>
                    </li>
                    <li class="page-item">
                        <button type="button" class="page-link" data-model="page" data-value="{{ total }}" data-action="live#update">&gt;&gt;</button>
                    </li>
                {% else %}
                    <li class="page-item disabled">
                        <span class="page-link">&gt;</span>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">&gt;&gt;</span>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}
{% endmacro %}

<div {{ attributes }} data-loading="addClass(opacity-50)">

    <div class="card">
        {% set label = computed.getMetadata().getLabel(computed.group)|trans %}
        {% if label %}
            <div class="card-header border-bottom-0">
                <h3 class="display-3 m-0">{{ computed.getMetadata().getLabel(computed.group)|trans }}</h3>
            </div>
        {% endif %}

        <div class="card-body p-0">
            <style>
                .table-in-card th:first-child, .table-in-card td:first-child {
                    border-left: none;
                }
                .table-in-card th:last-child, .table-in-card td:last-child {
                    border-right: none;
                }
            </style>
            <table class="table table-hover table-bordered table-in-card m-0">
                <tr>
                    {% for name, metadata in computed.getMetadata().getPropertiesMetadata(computed.group) %}
                        <th class="text-center"{% if computed.displayStatuses() %} rowspan="2"{% endif %}>
                            {{ metadata.getLabel(computed.group)|trans }}
                        </th>
                    {% endfor %}
                    {% if computed.displayStatuses() %}
                        <th colspan="{{ computed.getStatusesToDisplay()|length }}">Статусы</th>
                    {% endif %}
                </tr>
                {% if computed.displayStatuses() %}
                    <tr>
                        {% for status in computed.getStatusesToDisplay() %}
                            <th style="writing-mode: sideways-lr;">{{ status.name|trans }}</th>
                        {% endfor %}
                    </tr>
                {% endif %}
                {% for entity in computed.getTableData() %}
                    <tr style="transform: rotate(0);">
                        {% for name, metadata in computed.getMetadata().getPropertiesMetadata(computed.group) %}
                            {% set valueClass = metadata.getValueClass(computed.group) %}

                            {% if metadata.withUrl(computed.group) %}
                                <th scope="row">
                            {% else %}
                                <td{% if valueClass=='SprintF\\ValueObjects\\Value\\MoneyValue' %} class="text-end"{% endif %}>
                            {% endif %}

                                {% if metadata.withUrl(computed.group) %}<a href="{{ this.getRowUrl(entity) }}" class="stretched-link" data-turbo="false">{% endif %}
                                {{ (this.getPropertyValue(entity, metadata.name) ?? '-')|raw }}
                                {% if metadata.withUrl(computed.group) %}</a>{% endif %}

                            {% if metadata.withUrl(computed.group) %}
                                </th>
                            {% else %}
                                </td>
                            {% endif %}

                        {% endfor %}
                        {% if computed.displayStatuses() %}
                            {% for status in computed.getStatusesToDisplay() %}
                                <td class="text-center">
                                    {% if status.setEntity(entity).__invoke() %}
                                        <i class="bi bi-check"></i>
                                    {% else %}
                                        <i class="bi bi-x"></i>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        {% endif %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ computed.getMetadata().getPropertiesMetadata(computed.group)|length }}" class="text-center text-muted">Нет данных</td>
                    </tr>
                {% endfor %}
            </table>
        </div>

        <div class="card-footer border-top-0 m-0 p-1 row justify-content-between">
            <div class="col-auto">
                <nav class="d-inline-block">
                    <select class="form-select form-select-sm" style="font-size: 0.75rem !important;" data-model="perPage">
                        <option>5</option>
                        <option>10</option>
                        <option>25</option>
                        <option>50</option>
                        <option>100</option>
                    </select>
                </nav>
                <div class="d-inline-block">
                    из {{ data.getTotalCount() }}
                </div>
            </div>
            <div class="col-auto">
                {{ _self.pager(computed.getPagesCount(), this.page) }}
            </div>
        </div>
    </div>

</div>